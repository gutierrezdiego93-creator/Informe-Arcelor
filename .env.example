# Credenciales del consumidor OAuth (Fracttal One > Configuración > Conexiones API > Consumidores OAuth)
FRACTTAL_CLIENT_KEY=tu_clave
FRACTTAL_CLIENT_SECRET=tu_secreto

# Ubicación cuyo árbol de activos se muestra en el selector (default: ARCELOR01)
FRACTTAL_LOCATION_CODE=ARCELOR01

# Opcionales (defaults correctos para producción)
FRACTTAL_TOKEN_URL=https://one.fracttal.com/oauth/token
FRACTTAL_BASE_URL=https://app.fracttal.com/api
